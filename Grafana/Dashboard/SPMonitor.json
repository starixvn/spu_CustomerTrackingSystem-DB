          "rawSql": "SELECT  \n\t\ttrx.trx_mysql_thread_id AS 'ThreadID'\n\t,\tth.PROCESSLIST_USER AS 'User'\n    ,\tth.PROCESSLIST_HOST AS 'Host'\n    ,\tCASE\tWHEN trx.trx_query IS NOT NULL  THEN trx.trx_query\n\t\t\t\tELSE th.PROCESSLIST_INFO\n\t\tEND AS \t'Query' \n\t,\tFORMAT_PICO_TIME(TIMESTAMPDIFF(SECOND, trx.trx_started, NOW())*1000000000000) AS 'Latency'\n\t,\ttrx.trx_tables_locked AS 'Table Locked'\n    ,\ttrx.trx_rows_locked AS 'Row Locked'\n    ,\ttrx.trx_isolation_level AS 'Isolation'\n\t,\ttrx.trx_state AS 'State'\n    ,\ttrx.trx_started AS 'Start Time'\nFROM  INFORMATION_SCHEMA.INNODB_TRX AS trx\nLEFT JOIN performance_schema.threads AS th ON trx.trx_mysql_thread_id =  th.PROCESSLIST_ID;",
          "refId": "A",
