#network
NETWORK_NAME=cts-streaming-network
NETWORK_DRIVER=bridge
NETWORK_EXTERNAL=true

#neo4j
NEO4J_TAG=4.0.3
NEO4J_HOST=cts-neo4j-core01
NEO4J_PORT_WEB=7474
NEO4J_PORT_BOLT=7687
NEO4J_DATA=/volumes/cts-neo4j-core01/data
NEO4J_LOGS=/volumes/cts-neo4j-core01/logs
NEO4J_PLUGINS=./plugins
NEO4J_IMPORT=/volumes/cts-neo4j-core01/import
NEO4J_RUN=/volumes/cts-neo4j-core01/run
NEO4J_TZ="America/La_Paz"
NEO4J_CONF=/volumes/cts-neo4j-core01/conf

NEO4J_DEBUG_LEVEL=INFO
NEO4J_DBMS_MEMORY_HEAP_INIT=1G
NEO4J_DBMS_MEMORY_HEAP_MAX=1G
NEO4J_DBMS_MEMORY_PAGECACHE=2G
NEO4J_DBMS_MEMORY_TXN_GLOBAL=2G
NEO4J_DBMS_MEMORY_TXN_DB=2G
NEO4J_DBMS_MEMORY_TXN=32M
NEO4J_TXN_LOG_ROTATION_SIZE=100M

#kafka
ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_CONNECT=broker:9093